# Copy to .env.local for development. Never commit real values.

# Public (safe in the browser) — Supabase project URL and anon key
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical site URL (used for sitemap, Open Graph, auth email links)
NEXT_PUBLIC_SITE_URL=https://www.your-domain.org
# Optional: separate public and admin domains (NEXT_PUBLIC_SITE_URL is then the admin domain)
# PUBLIC_WEBSITE_URL=https://newlifeglobalaz.org

# SERVER ONLY — never prefix with NEXT_PUBLIC_. Used for inviting staff users and for writing the
# finance notification log (notification settings are not readable by the public).
SUPABASE_SERVICE_ROLE_KEY=

# SERVER ONLY — random string used to hash visitor IPs for rate limiting
RATE_LIMIT_SALT=

# SERVER ONLY — email notifications (https://resend.com). Finance recipients are set in
# Admin › Giving › Notifications, not here. Without these, submissions are still saved and every
# notification is logged as failed so it can be resent once email is configured.
RESEND_API_KEY=
EMAIL_FROM="New Life Global <give@newlifeglobalaz.org>"
# Website message alerts (contact, plan a visit, prayer). Defaults: EMAIL_FROM and support@newlifeglobalaz.org
# MESSAGE_ALERTS_FROM="New Life Global <support@newlifeglobalaz.org>"
# MESSAGE_ALERTS_TO=support@newlifeglobalaz.org
