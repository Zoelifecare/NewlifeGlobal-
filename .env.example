# Copy to .env.local for development. Never commit real values.

# Public (safe in the browser) — Supabase project URL and anon key
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical site URL (used for sitemap, Open Graph, auth email links)
NEXT_PUBLIC_SITE_URL=https://www.your-domain.org

# SERVER ONLY — never prefix with NEXT_PUBLIC_. Used only for inviting staff users.
SUPABASE_SERVICE_ROLE_KEY=

# SERVER ONLY — random string used to hash visitor IPs for rate limiting
RATE_LIMIT_SALT=
